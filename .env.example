DATABASE_URL=postgres://ubuntu:myplace@localhost:5432/myplace
SESSION_SECRET=dev-insecure-change-me
PORT=8787
APP_ORIGIN=http://localhost:5173
DEV_MAILBOX=true
# Same R2 bucket the Worker binds. With these set, local/tunnel uploads
# go to Cloudflare instead of the machine's disk.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# R2_BUCKET=myplace-documents
# Optional Mapbox token. Without it, the map uses OpenFreeMap.
# VITE_MAPBOX_TOKEN=
