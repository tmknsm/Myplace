{
  "name": "myplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/src/local.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p server/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf:setup": "bash scripts/cloudflare-setup.sh",
    "cf:dev": "wrangler dev",
    "db:migrate": "tsx db/migrate.ts",
    "db:import": "tsx db/import.ts",
    "db:overlays": "tsx db/import-overlays.ts",
    "db:backfill-fields": "tsx db/backfill-roll-fields.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/migrate.ts --reset && tsx db/import.ts",
    "db:reset:sample": "tsx db/migrate.ts --reset && tsx db/seed.ts",
    "setup": "tsx db/migrate.ts && tsx db/import.ts",
    "setup:sample": "tsx db/migrate.ts && tsx db/seed.ts",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://ubuntu:myplace@localhost:5432/myplace_test} vitest run",
    "start": "tsx server/src/local.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "hono": "^4.9.8",
    "maplibre-gl": "^5.7.1",
    "postgres": "^3.4.7",
    "proj4": "^2.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "ulid": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  }
}
